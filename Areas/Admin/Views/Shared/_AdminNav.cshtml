@{
    var action = ViewContext.RouteData.Values["controller"]?.ToString();
    string Cls(string c) => c == action ? "asc-chip active" : "asc-chip";
}

<div class="d-flex align-items-center justify-content-between mt-4 mb-3 flex-wrap gap-2">
    <div>
        <p class="eyebrow mb-1">ADMIN</p>
        <h1 class="mb-0">Manage</h1>
    </div>
    <a class="asc-nav-link" asp-area="" asp-controller="Home" asp-action="Index">
        <i class="ti ti-arrow-left"></i> Back to site
    </a>
</div>

<div class="d-flex gap-2 flex-wrap mb-4">
    <a class="@Cls("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Overview</a>
    <a class="@Cls("Regions")" asp-area="Admin" asp-controller="Regions" asp-action="Index">Regions</a>
    <a class="@Cls("Tags")" asp-area="Admin" asp-controller="Tags" asp-action="Index">Tags</a>
    <a class="@Cls("Badges")" asp-area="Admin" asp-controller="Badges" asp-action="Index">Badges</a>
    <a class="@Cls("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="asc-panel mb-3" style="border-color:var(--forest)">
        <i class="ti ti-check" style="color:var(--forest)"></i> @ok
    </div>
}
@if (TempData["Err"] is string err)
{
    <div class="asc-panel mb-3" style="border-color:var(--terracotta)">
        <i class="ti ti-alert-triangle" style="color:var(--terracotta)"></i> @err
    </div>
}
