@model ascent_app.Areas.Admin.ViewModels.RegionFormViewModel
@{
    ViewData["Title"] = "New region";
}

<partial name="_AdminNav" />

<div class="auth-wrap">
    <h2 class="mb-3" style="font-size:22px">New region</h2>
    <div class="asc-panel">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-ascent">Create</button>
                <a class="btn-ascent-outline" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
