@model ascent_app.Areas.Admin.ViewModels.TagFormViewModel
@{
    ViewData["Title"] = "Edit tag";
}

<partial name="_AdminNav" />

<div class="auth-wrap">
    <h2 class="mb-3" style="font-size:22px">Edit tag</h2>
    <div class="asc-panel">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-ascent">Save</button>
                <a class="btn-ascent-outline" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
