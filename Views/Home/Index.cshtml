@model List<Trail>
@using System.Globalization
@{
    ViewData["Title"] = "Home";
    string Pct(double v) => v.ToString(CultureInfo.InvariantCulture);

    // Ridge: four picks spread across the gain range, lowest climb first, so the line
    // climbs left to right. Each dot's height is that trail's real elevation gain
    // (viewBox 1000x400: y 392 = 0 m, y 32 = the biggest climb of the four).
    var byGain = Model.OrderBy(t => t.ElevationGainM).ToList();
    var waypoints = byGain.Count <= 4
        ? byGain
        : new[] { 0, (byGain.Count - 1) / 3, 2 * (byGain.Count - 1) / 3, byGain.Count - 1 }.Select(i => byGain[i]).ToList();
    var maxGain = Math.Max(1, waypoints.LastOrDefault()?.ElevationGainM ?? 1);
    var stops = waypoints.Select((t, i) => (
        x: waypoints.Count == 1 ? 760 : 250 + i * 510 / (waypoints.Count - 1),
        y: 392 - (int)Math.Round(360.0 * t.ElevationGainM / maxGain))).ToList();

    var verts = new List<(int x, int y)> { (0, 392) };
    var prev = verts[0];
    foreach (var st in stops)
    {
        // two saddles between dots, both below the straight line so the dot stays a local high
        verts.Add((prev.x + (st.x - prev.x) / 3, Math.Min(392, prev.y + (st.y - prev.y) / 3 + 14)));
        verts.Add((prev.x + 2 * (st.x - prev.x) / 3, Math.Min(392, prev.y + 2 * (st.y - prev.y) / 3 + 6)));
        verts.Add(st);
        prev = st;
    }
    verts.Add((prev.x + 50, Math.Min(380, prev.y + 40)));
    verts.Add((prev.x + 100, Math.Min(380, prev.y + 70)));
    verts.Add((900, Math.Min(380, prev.y + 110)));
    var ridgePath = "M" + string.Join(" L", verts.Select(v => $"{v.x} {v.y}"));
    var example = Model.FirstOrDefault();
    var exampleScore = example == null ? 0 : Math.Sqrt(2 * example.ElevationGainM * example.DistanceKm);
}

<section class="ascent-scroll" id="ascent">
    <div class="ascent-stage">
        <div class="stage-bg" aria-hidden="true">
            @for (var i = 0; i < waypoints.Count; i++)
            {
                <img src="@waypoints[i].CoverImageUrl" alt="" decoding="async" data-i="@i"
                     onerror="this.remove();"/>
            }
        </div>
        <div class="ascent-copy">
            <h1>Know the climb<br>before you go.</h1>
            <p>Real hiking routes with distance, elevation and a difficulty that is computed from the numbers, not guessed. Sorted by what is nearest to you.</p>
            <div class="ascent-actions">
                <a class="btn-ascent" asp-controller="Trails" asp-action="Index">Browse trails</a>
                <a class="btn-ascent-outline" asp-controller="Trails" asp-action="Nearby"><i class="ti ti-navigation"></i> Trails near me</a>
            </div>
            <div class="scroll-hint" id="scroll-hint"><i class="ti ti-arrow-down"></i> Scroll to climb</div>
        </div>

        <div class="ridge" aria-hidden="true">
            <svg class="ridge-svg" viewBox="0 0 1000 400" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="ridge-fill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#2C5F4A" stop-opacity=".18"/>
                        <stop offset="1" stop-color="#2C5F4A" stop-opacity="0"/>
                    </linearGradient>
                    <clipPath id="ridge-clip"><rect id="ridge-clip-rect" x="0" y="0" width="0" height="400"/></clipPath>
                </defs>
                <path class="ridge-area" clip-path="url(#ridge-clip)" fill="url(#ridge-fill)" d="@ridgePath L900 400 L0 400 Z"/>
                <path class="ridge-ghost" d="@ridgePath"/>
                <path class="ridge-line" id="ridge-line" d="@ridgePath" data-max="@maxGain"/>
            </svg>

            @for (var i = 0; i < waypoints.Count; i++)
            {
                var t = waypoints[i];
                var s = stops[i];
                <a class="wp@(i == waypoints.Count - 1 ? " summit" : "")" style="left:@Pct(s.x / 10.0)%; bottom:@Pct((400 - s.y) / 4.0)%" data-at="@Pct(s.x / 1000.0)"
                   asp-controller="Trails" asp-action="Details" asp-route-id="@t.Id">
                    <span class="wp-dot"></span>
                    <span class="wp-label">
                        <span class="wp-name">@t.Name</span>
                        <span class="wp-stats">@t.DistanceKm.ToString("0.#") km, @t.ElevationGainM.ToString("N0") m up</span>
                    </span>
                </a>
            }

            <div class="climber" id="climber">
                <span class="climber-dot"></span>
                <span class="climber-alt"><b id="climber-m">0</b> m up</span>
            </div>
        </div>
    </div>
</section>

<section class="picks">
    <div class="picks-head">
        <h2>Hikers' picks</h2>
        <a asp-controller="Trails" asp-action="Index">All trails</a>
    </div>
    @foreach (var t in Model)
    {
        var diffClass = t.Difficulty?.Label.ToLower() ?? "easy";
        <a class="pick" asp-controller="Trails" asp-action="Details" asp-route-id="@t.Id">
            <img src="@t.CoverImageUrl" alt="" loading="lazy" onerror="this.onerror=null;this.src='/images/trails/default-trail.svg';"/>
            <span class="pick-main">
                <span class="pick-name">@t.Name</span>
                <span class="pick-where">@t.Region?.Name, @t.Region?.Country</span>
            </span>
            <span class="pick-meta">
                <span class="pick-num">@t.DistanceKm.ToString("0.#") km</span>
                <span class="pick-num">@t.ElevationGainM.ToString("N0") m</span>
                <span class="diff-badge pick-diff diff-@diffClass">@t.Difficulty?.Label</span>
                <span class="pick-rating">
                    @if (t.AverageRating > 0)
                    {
                        <i class="ti ti-star-filled"></i> @t.AverageRating.ToString("0.0")
                    }
                    else
                    {
                        <span class="text-muted">No reviews</span>
                    }
                </span>
            </span>
        </a>
    }
</section>

@if (example != null)
{
    <section class="rating">
        <div class="rating-copy">
            <h2>Difficulty is computed, not guessed.</h2>
            <p>
                Every trail gets a score of <span class="formula">√(2 × climb × distance)</span>.
                @example.Name is @example.DistanceKm.ToString("0.#") km with @example.ElevationGainM.ToString("N0") m of climb,
                which scores @exampleScore.ToString("0") and lands in @example.Difficulty?.Label.
                Nobody can override it, so a Hard trail in one region is a Hard trail everywhere.
            </p>
        </div>
        <div class="rating-scale">
            <div class="scale-bar">
                <span class="diff-easy">Easy</span>
                <span class="diff-moderate">Moderate</span>
                <span class="diff-hard">Hard</span>
                <span class="diff-strenuous">Strenuous</span>
                <i class="scale-mark" style="left:@Pct(Math.Min(exampleScore, 200) / 2)%"></i>
            </div>
            <div class="scale-ticks"><span style="left:0">0</span><span style="left:25%">50</span><span style="left:50%">100</span><span style="left:85%">170</span><span style="left:100%">200+</span></div>
        </div>
    </section>
}

@section Styles {
    <style>
        .ascent-scroll { height: 280vh; margin: 0 0 24px; }
        .ascent-stage {
            position: sticky;
            top: 0;
            height: calc(100vh - 75px);
            height: calc(100svh - 75px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .stage-bg { position: absolute; inset: 0; z-index: 0; }
        .stage-bg img {
            position: absolute;
            inset: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            opacity: 0;
            transition: opacity .9s ease;
        }
        .stage-bg img.is-on { opacity: 1; }
        .stage-bg::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(90deg, rgba(var(--bg-rgb), .97) 0%, rgba(var(--bg-rgb), .8) 38%, rgba(var(--bg-rgb), .3) 68%, rgba(var(--bg-rgb), .35) 88%, rgba(var(--bg-rgb), .95) 100%),
                linear-gradient(180deg, rgba(var(--bg-rgb), .9) 0%, rgba(var(--bg-rgb), .2) 28%, rgba(var(--bg-rgb), .1) 50%, rgba(var(--bg-rgb), .92) 100%);
        }
        .ascent-copy { padding-top: clamp(28px, 7vh, 72px); max-width: 620px; position: relative; z-index: 2; }
        .ascent-copy h1 {
            font-size: clamp(40px, 6.4vw, 78px);
            line-height: 0.98;
            letter-spacing: -1.5px;
            margin: 0 0 20px;
            font-variation-settings: "opsz" 144;
        }
        .ascent-copy p {
            font-size: 17px;
            color: var(--text-secondary);
            max-width: 46ch;
            margin: 0 0 24px;
        }
        .ascent-actions { display: flex; gap: 10px; flex-wrap: wrap; }

        .ridge {
            position: relative;
            z-index: 1;
            margin-top: auto;
            height: 52vh;
            height: 52svh;
            min-height: 220px;
        }
        .ridge-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
        .ridge-ghost, .ridge-line {
            fill: none;
            stroke-linejoin: round;
            stroke-linecap: round;
            vector-effect: non-scaling-stroke;
        }
        .ridge-ghost { stroke: var(--border); stroke-width: 1; stroke-dasharray: 3 6; }
        .ridge-line { stroke: var(--forest-dark); stroke-width: 2; }

        .wp, .climber {
            position: absolute;
            width: 0; height: 0;
            color: var(--text);
        }
        .wp {
            opacity: 0;
            transition: opacity .45s ease, transform .45s ease;
            transform: translateY(8px);
            pointer-events: none;
        }
        .wp.is-on { opacity: 1; transform: none; pointer-events: auto; }
        .wp-dot {
            position: absolute;
            left: -5px; top: -5px;
            width: 10px; height: 10px;
            border-radius: 50%;
            background: var(--bg);
            border: 2px solid var(--forest-dark);
        }
        .wp:hover .wp-dot { background: var(--terracotta); border-color: var(--terracotta); }
        .wp-label {
            position: absolute;
            bottom: 30px;
            display: flex;
            flex-direction: column;
            white-space: nowrap;
            line-height: 1.3;
        }
        .wp-label { right: 0; align-items: flex-end; text-align: right; text-shadow: 0 0 2px var(--bg), 0 0 10px var(--bg), 0 0 18px var(--bg); }
        .climber-alt { text-shadow: 0 0 2px var(--bg), 0 0 10px var(--bg), 0 0 18px var(--bg); }
        .wp-label::after {
            content: "";
            position: absolute;
            top: 100%;
            width: 1px; height: 22px;
            margin-top: 4px;
            background: var(--border-strong);
        }
        .wp-label::after { right: 0; }
        .wp-name { font-family: var(--font-display); font-size: 15px; color: var(--forest-dark); }
        .wp:hover .wp-name { color: var(--terracotta); }
        .wp-stats { font-size: 12px; color: var(--text-muted); }
        .summit .wp-name { color: var(--text); font-size: 16px; }
        .summit .wp-dot { border-color: var(--terracotta); background: var(--terracotta); }

        .climber { pointer-events: none; z-index: 3; }
        .climber-dot {
            position: absolute;
            left: -7px; top: -7px;
            width: 14px; height: 14px;
            border-radius: 50%;
            background: var(--terracotta);
            box-shadow: 0 0 0 5px rgba(204, 131, 85, .22);
        }
        .climber-alt {
            position: absolute;
            left: 18px; top: 0;
            transform: translateY(-50%);
            font-family: var(--font-display);
            font-size: 22px;
            color: var(--text);
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }
        .climber-alt b { font-weight: 500; }

        .scroll-hint {
            margin-top: 28px;
            font-size: 13px;
            color: var(--text-muted);
            display: flex; align-items: center; gap: 6px;
            transition: opacity .3s;
        }
        .scroll-hint .ti { animation: hint-bob 1.6s ease-in-out infinite; }
        @@keyframes hint-bob { 50% { transform: translateY(4px); } }

        .picks { margin-top: 32px; }
        .picks-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
        .picks-head h2 { font-size: 30px; margin: 0; }
        .picks-head a { font-size: 14px; }
        .pick {
            display: grid;
            grid-template-columns: 72px 1fr auto;
            gap: 20px;
            align-items: center;
            padding: 14px 0;
            border-top: 0.5px solid var(--border);
            color: var(--text);
        }
        .pick:last-child { border-bottom: 0.5px solid var(--border); }
        .pick img { width: 72px; height: 52px; object-fit: cover; border-radius: 6px; background: var(--surface-alt); }
        .pick-main { display: flex; flex-direction: column; min-width: 0; }
        .pick-name { font-family: var(--font-display); font-size: 19px; color: var(--forest-dark); line-height: 1.2; }
        .pick:hover .pick-name { color: var(--terracotta); }
        .pick-where { font-size: 13px; color: var(--text-muted); }
        .pick-meta { display: flex; align-items: center; gap: 22px; font-size: 14px; color: var(--text-secondary); }
        .pick-num { font-variant-numeric: tabular-nums; min-width: 58px; text-align: right; }
        .pick-diff { position: static; }
        .pick-rating { min-width: 64px; display: inline-flex; align-items: center; gap: 4px; }
        .pick-rating .ti { color: var(--terracotta); font-size: 13px; }

        .rating {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            align-items: center;
            margin: 56px 0 24px;
        }
        .rating h2 { font-size: 26px; margin-bottom: 10px; }
        .rating p { color: var(--text-secondary); max-width: 52ch; margin: 0; }
        .formula { font-family: var(--font-display); font-style: italic; color: var(--text); }
        .scale-bar {
            position: relative;
            display: grid;
            grid-template-columns: 50fr 50fr 70fr 30fr;
            border-radius: var(--r-badge);
            overflow: visible;
        }
        .scale-bar > span {
            padding: 9px 0;
            text-align: center;
            font-size: 12px;
            font-weight: 600;
        }
        .scale-bar > span:first-child { border-radius: var(--r-badge) 0 0 var(--r-badge); }
        .scale-bar > span:nth-child(4) { border-radius: 0 var(--r-badge) var(--r-badge) 0; }
        .scale-mark {
            position: absolute;
            top: -6px; bottom: -6px;
            width: 2px;
            margin-left: -1px;
            background: var(--forest-dark);
            border-radius: 2px;
        }
        .scale-ticks {
            position: relative;
            height: 18px;
            margin-top: 6px;
            font-size: 12px;
            color: var(--text-muted);
            font-variant-numeric: tabular-nums;
        }
        .scale-ticks span { position: absolute; transform: translateX(-50%); }
        .scale-ticks span:first-child { transform: none; }
        .scale-ticks span:last-child { transform: translateX(-100%); }

        @@media (max-width: 991px) {
            .rating { grid-template-columns: 1fr; gap: 24px; }
        }
        @@media (max-width: 767px) {
            .ascent-scroll { height: 220vh; }
            .stage-bg::after {
                background: linear-gradient(180deg, rgba(var(--bg-rgb), .96) 0%, rgba(var(--bg-rgb), .9) 42%, rgba(var(--bg-rgb), .5) 62%, rgba(var(--bg-rgb), .45) 80%, rgba(var(--bg-rgb), .92) 100%);
            }
            .ridge { height: 34svh; }
            .wp:not(.summit) .wp-label { display: none; }
            .wp:not(.summit).is-on { pointer-events: none; }
            .summit .wp-name { font-size: 14px; }
            .climber-alt { font-size: 18px; left: 10px; top: auto; bottom: 12px; transform: translateX(-100%); }
            .pick { grid-template-columns: 56px 1fr; gap: 12px 14px; }
            .pick img { width: 56px; height: 42px; }
            .pick-meta { grid-column: 2; gap: 14px; font-size: 13px; }
            .pick-num { min-width: 0; text-align: left; }
            .pick-rating { min-width: 0; }
        }
        @@media (prefers-reduced-motion: reduce) {
            .stage-bg img { transition: none; }
            .ascent-scroll { height: auto; }
            .ascent-stage { position: static; height: auto; min-height: 0; }
            .ridge { margin-top: 32px; height: 300px; }
            .wp { transition: none; }
            .scroll-hint { display: none; }
        }
    </style>
}

@section Scripts {
    <script>
        (function () {
            const section = document.getElementById("ascent");
            const line = document.getElementById("ridge-line");
            const clip = document.getElementById("ridge-clip-rect");
            const climber = document.getElementById("climber");
            const metres = document.getElementById("climber-m");
            const hint = document.getElementById("scroll-hint");
            const marks = Array.from(section.querySelectorAll("[data-at]"));
            const photos = Array.from(section.querySelectorAll(".stage-bg img"));
            if (!line) return;
            const maxGain = parseFloat(line.dataset.max) || 1;

            const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const pts = line.getAttribute("d").match(/-?[\d.]+/g).map(Number);
            const box = line.closest(".ridge");
            let segs = [], length = 0;

            // Dashes are measured in screen pixels (non-scaling stroke), so walk the
            // polyline at the box's current scale instead of using getTotalLength().
            function measure() {
                const sx = box.clientWidth / 1000, sy = box.clientHeight / 400;
                segs = []; length = 0;
                for (let i = 2; i < pts.length; i += 2) {
                    const d = Math.hypot((pts[i] - pts[i - 2]) * sx, (pts[i + 1] - pts[i - 1]) * sy);
                    segs.push({ x0: pts[i - 2], y0: pts[i - 1], x1: pts[i], y1: pts[i + 1], start: length, len: d });
                    length += d;
                }
                line.style.strokeDasharray = length;
            }

            function pointAt(dist) {
                const s = segs.find(g => dist <= g.start + g.len) || segs[segs.length - 1];
                const t = s.len ? Math.min((dist - s.start) / s.len, 1) : 1;
                return { x: s.x0 + (s.x1 - s.x0) * t, y: s.y0 + (s.y1 - s.y0) * t };
            }

            function render(p) {
                line.style.strokeDashoffset = length * (1 - p);
                const pt = pointAt(length * p);
                clip.setAttribute("width", pt.x);
                climber.style.left = pt.x / 10 + "%";
                climber.style.top = pt.y / 4 + "%";
                metres.textContent = Math.max(0, Math.round((392 - pt.y) / 360 * maxGain)).toLocaleString("en");
                const frac = pt.x / 1000;
                marks.forEach(m => m.classList.toggle("is-on", frac >= parseFloat(m.dataset.at)));
                const passed = marks.filter(m => frac >= parseFloat(m.dataset.at)).length;
                photos.forEach(img => img.classList.toggle("is-on", parseInt(img.dataset.i) === passed - 1));
                hint.style.opacity = p > 0.2 ? "0" : "1";
            }

            measure();
            if (reduce) { render(1); window.addEventListener("resize", () => { measure(); render(1); }); return; }

            let ticking = false;
            function onScroll() {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                    const travel = section.offsetHeight - window.innerHeight;
                    const scrolled = -section.getBoundingClientRect().top;
                    const p = Math.min(Math.max(scrolled / travel, 0), 1);
                    render(0.06 + p * 0.94);
                    ticking = false;
                });
            }
            window.addEventListener("scroll", onScroll, { passive: true });
            window.addEventListener("resize", () => { measure(); onScroll(); });
            onScroll();
        })();
    </script>
}
