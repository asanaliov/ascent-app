@model ascent_app.ViewModels.GuideTrailsViewModel
@{
    ViewData["Title"] = "My trails";
}

<div class="d-flex align-items-end justify-content-between mt-4 mb-3">
    <div>
        <p class="eyebrow mb-1">GUIDE TOOLS</p>
        <h1 class="mb-0">My trails</h1>
    </div>
    <a asp-controller="Trails" asp-action="Create" class="btn-ascent">
        <i class="ti ti-plus"></i> Add trail
    </a>
</div>

<p class="meta-row text-muted mb-4">
    <span><i class="ti ti-route"></i> @Model.TrailCount trail@(Model.TrailCount == 1 ? "" : "s") authored</span>
    <span><i class="ti ti-users"></i> @Model.TotalHikes total hike@(Model.TotalHikes == 1 ? "" : "s")</span>
</p>

@if (Model.Rows.Count == 0)
{
    <div class="asc-panel text-center text-muted">
        <i class="ti ti-mountain" style="font-size:32px;opacity:.5"></i>
        <p class="mb-1 mt-2">You haven't authored any trails yet.</p>
        <a asp-controller="Trails" asp-action="Create">Add your first trail →</a>
    </div>
}
else
{
    foreach (var row in Model.Rows)
    {
        var label = row.Trail.Difficulty?.Label ?? "";
        <div class="asc-panel mb-3">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <div class="tc-region"><i class="ti ti-map-pin"></i> @row.Trail.Region?.Name</div>
                    <h3 class="tc-title mb-1">
                        <a asp-controller="Trails" asp-action="Details" asp-route-id="@row.Trail.Id">@row.Trail.Name</a>
                    </h3>
                    <div class="meta-row">
                        @if (!string.IsNullOrEmpty(label))
                        {
                            <span class="diff-inline diff-@label.ToLowerInvariant()">@label</span>
                        }
                        <span><i class="ti ti-route"></i> @row.Trail.DistanceKm km</span>
                        <span><i class="ti ti-mountain"></i> @row.Trail.ElevationGainM m</span>
                        <span><i class="ti ti-star"></i> @(row.AverageRating == 0 ? "—" : row.AverageRating.ToString())</span>
                        <span><i class="ti ti-users"></i> @row.HikeCount</span>
                    </div>
                    @if (row.Trail.TrailTags.Any())
                    {
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @foreach (var tt in row.Trail.TrailTags)
                            {
                                <span class="asc-chip"><i class="ti ti-tag"></i> @tt.Tag?.Name</span>
                            }
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 flex-shrink-0">
                    <a asp-controller="Trails" asp-action="Edit" asp-route-id="@row.Trail.Id"
                       class="btn-ascent-outline" title="Edit"><i class="ti ti-edit"></i> Edit</a>
                    <a asp-controller="Trails" asp-action="Delete" asp-route-id="@row.Trail.Id"
                       class="btn-ascent-outline" title="Delete"><i class="ti ti-trash"></i></a>
                </div>
            </div>
        </div>
    }
}
