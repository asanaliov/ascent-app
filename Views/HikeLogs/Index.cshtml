@model IEnumerable<ascent_app.Models.HikeLog>
@{
    ViewData["Title"] = "My hikes";
    var badges = ViewBag.Badges as List<ascent_app.Models.Badge> ?? new();
}

@if (TempData["NewBadges"] is string newBadges)
{
    <div class="asc-panel mt-4 mb-2" style="border-color:var(--terracotta)">
        <i class="ti ti-award" style="color:var(--terracotta)"></i>
        <strong>New badge@(newBadges.Contains(',') ? "s" : "") earned:</strong> @newBadges
    </div>
}
@if (TempData["PhotoError"] is string photoError)
{
    <div class="asc-panel mt-4 mb-2" style="border-color:var(--terracotta)">
        <i class="ti ti-alert-triangle" style="color:var(--terracotta)"></i> @photoError
    </div>
}

<div class="d-flex align-items-end justify-content-between mt-4 mb-3">
    <div>
        <p class="eyebrow mb-1">YOUR ACTIVITY</p>
        <h1 class="mb-0">My hikes</h1>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        @if (!Model.Any())
        {
            <div class="asc-panel text-center text-muted">
                <i class="ti ti-route" style="font-size:32px;opacity:.5"></i>
                <p class="mb-1 mt-2">You haven't logged any hikes yet.</p>
                <a asp-controller="Trails" asp-action="Index">Find a trail to hike →</a>
            </div>
        }
        else
        {
            foreach (var hike in Model)
            {
                var diffClass = (hike.Trail.Difficulty?.Label ?? "").ToLowerInvariant();
                <div class="asc-panel mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="tc-region"><i class="ti ti-map-pin"></i> @hike.Trail.Region?.Name</div>
                            <h3 class="tc-title mb-1">
                                <a asp-controller="Trails" asp-action="Details" asp-route-id="@hike.TrailId">@hike.Trail.Name</a>
                            </h3>
                            <div class="meta-row">
                                <span><i class="ti ti-calendar"></i> @hike.HikedOn.ToString("MMM d, yyyy")</span>
                                @if (hike.DurationMinutes is int min)
                                {
                                    <span><i class="ti ti-clock"></i> @min min</span>
                                }
                                @if (hike.Trail.Difficulty is not null)
                                {
                                    <span class="diff-inline diff-@diffClass">@hike.Trail.Difficulty.Label</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(hike.Notes))
                            {
                                <p class="text-secondary mb-0 mt-2" style="font-size:14px">@hike.Notes</p>
                            }
                        </div>
                        <form asp-action="Delete" asp-route-id="@hike.Id" method="post"
                              onsubmit="return confirm('Delete this hike log?');">
                            <button type="submit" class="btn-ascent-outline" title="Delete"><i class="ti ti-trash"></i></button>
                        </form>
                    </div>

                    @if (hike.Photos.Any())
                    {
                        <div class="photo-strip mt-3">
                            @foreach (var photo in hike.Photos)
                            {
                                <figure class="photo-thumb">
                                    <img src="@photo.Url" alt="@photo.Caption" />
                                    <form asp-action="DeletePhoto" asp-route-id="@photo.Id" method="post"
                                          onsubmit="return confirm('Delete this photo?');">
                                        <button type="submit" class="photo-del" title="Delete photo"><i class="ti ti-x"></i></button>
                                    </form>
                                    @if (!string.IsNullOrWhiteSpace(photo.Caption))
                                    {
                                        <figcaption>@photo.Caption</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    }

                    <form asp-action="AddPhoto" method="post" enctype="multipart/form-data"
                          class="d-flex gap-2 align-items-center mt-3 flex-wrap">
                        <input type="hidden" name="hikeLogId" value="@hike.Id" />
                        <input type="file" name="photoFile" accept="image/png,image/jpeg,image/webp"
                               class="form-control form-control-sm" style="max-width:240px" required />
                        <input type="text" name="caption" placeholder="Caption (optional)"
                               class="form-control form-control-sm" style="max-width:200px" maxlength="200" />
                        <button type="submit" class="btn-ascent-outline" style="padding:6px 12px;font-size:13px">
                            <i class="ti ti-camera-plus"></i> Add photo
                        </button>
                    </form>
                </div>
            }
        }
    </div>

    <div class="col-md-4">
        <p class="eyebrow mb-2">BADGES EARNED</p>
        @if (badges.Count == 0)
        {
            <p class="text-muted" style="font-size:14px">No badges yet — log hikes to earn them.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var badge in badges)
                {
                    <div class="asc-panel d-flex align-items-center gap-3" style="padding:12px 14px">
                        <i class="ti @badge.IconName" style="font-size:24px;color:var(--forest)"></i>
                        <div>
                            <div style="font-weight:600">@badge.Name</div>
                            <div class="text-muted" style="font-size:12px">@badge.Description</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
