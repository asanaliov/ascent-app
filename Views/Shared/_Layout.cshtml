<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Ascent</title>
    <link rel="icon" type="image/png" href="~/favicon.ico" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3/dist/tabler-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/ascent.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ascent_app.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header>
    <nav class="asc-navbar navbar navbar-expand-md py-0">
        <div class="container py-3">
            <a class="asc-brand navbar-brand p-0 m-0" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="mark"><i class="ti ti-mountain"></i></span>
                <span class="wm">Ascent<small>NORTH MACEDONIA</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ascNav"
                    aria-controls="ascNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="ascNav">
                <div class="ms-auto d-flex flex-column flex-md-row align-items-md-center gap-3 gap-md-4 py-3 py-md-0">
                    <a class="asc-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="asc-nav-link" asp-area="" asp-controller="Trails" asp-action="Index">Trails</a>
                    <a class="asc-nav-link" asp-area="" asp-controller="Community" asp-action="Index">Community</a>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>
</header>
@if (ViewData["FullWidth"] is true)
{
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
}
else
{
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
}

<footer class="footer">
    <div class="container">
        <div class="ft-grid">
            <div class="ft-brand">
                <a class="asc-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="mark"><i class="ti ti-mountain"></i></span>
                    <span class="wm">Ascent<small>NORTH MACEDONIA</small></span>
                </a>
                <p>Real hiking routes with distance, elevation and a difficulty computed from the numbers.</p>
            </div>
            <div class="ft-col">
                <h4>Explore</h4>
                <a asp-area="" asp-controller="Trails" asp-action="Index">All trails</a>
                <a asp-area="" asp-controller="Trails" asp-action="Nearby">Trails near me</a>
                <a asp-area="" asp-controller="Community" asp-action="Index">Community</a>
            </div>
            <div class="ft-col">
                <h4>Your account</h4>
                <a asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-area="" asp-controller="HikeLogs" asp-action="Index">My hikes</a>
                <a asp-area="" asp-controller="Favorites" asp-action="Index">Saved trails</a>
            </div>
            <div class="ft-col">
                <h4>Data</h4>
                <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">Map data © OpenStreetMap</a>
                <a href="https://brouter.de/" rel="noopener" target="_blank">Routes by BRouter</a>
                <a href="https://commons.wikimedia.org/" rel="noopener" target="_blank">Photos via Wikimedia Commons</a>
            </div>
        </div>
        <div class="ft-bottom">
            <span>&copy; 2026 Ascent. Designed and built by <a href="https://github.com/asanaliov" rel="noopener" target="_blank">Asan Aliov</a>.</span>
            <span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a href="https://github.com/asanaliov/ascent-app" rel="noopener" target="_blank"><i class="ti ti-brand-github"></i> Source</a>
            </span>
        </div>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
