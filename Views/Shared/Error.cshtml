@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth-wrap text-center">
    <i class="ti ti-alert-triangle" style="font-size:40px;color:var(--terracotta)"></i>
    <h1 class="mt-3 mb-2">Something went wrong</h1>
    <p class="text-muted mb-4">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted" style="font-size:13px">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn-ascent" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
