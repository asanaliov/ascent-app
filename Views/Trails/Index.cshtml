@using ascent_app.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using ascent_app.ViewModels
@model IEnumerable<ascent_app.Models.Trail>

@{
    ViewData["Title"] = "Trails";
    var mapTrails = ViewBag.MapTrails as string ?? "[]";
    var filter = ViewBag.Filter as TrailFilterViewModel ?? new TrailFilterViewModel();
    var tags = ViewBag.Tags as List<Tag> ?? new List<Tag>();
    var sort = ViewBag.Sort as string ?? "newest";
    var currentPage = ViewBag.Page is int p ? p : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 0;
    var totalCount = ViewBag.TotalCount is int tc ? tc : Model.Count();

    var userLat = ViewBag.UserLat as double?;
    var userLng = ViewBag.UserLng as double?;
    var located = userLat.HasValue && userLng.HasValue;
    var isLive = ViewBag.IsLiveLocation is true;
    var homeName = ViewBag.HomeName as string;
    var focusLat = ViewBag.FocusLat is double fla ? fla : 41.6;
    var focusLng = ViewBag.FocusLng is double flo ? flo : 21.7;
    var focusZoom = ViewBag.FocusZoom is double fz ? fz : 6.5;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    var sortOptions = new List<(string, string)>();
    if (located) sortOptions.Add(("nearest", "Nearest to me"));
    sortOptions.AddRange(new[]
    {
        ("newest", "Newest"),
        ("name", "Name"),
        ("distance", "Distance"),
        ("elevation", "Elevation"),
        ("rating", "Rating"),
    });

    var tagRoute = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(filter.Q)) tagRoute["q"] = filter.Q!;
    if (filter.RegionId.HasValue) tagRoute["regionId"] = filter.RegionId.Value.ToString();
    if (filter.DifficultyId.HasValue) tagRoute["difficultyId"] = filter.DifficultyId.Value.ToString();
    if (sort != "newest") tagRoute["sort"] = sort;
    if (isLive)
    {
        tagRoute["lat"] = userLat!.Value.ToString(inv);
        tagRoute["lng"] = userLng!.Value.ToString(inv);
    }

    var pageRoute = new Dictionary<string, string>(tagRoute);
    if (filter.TagId.HasValue) pageRoute["tagId"] = filter.TagId.Value.ToString();
}

@{
    var difficulties = ViewBag.Difficulties as SelectList;
    var regionName = (ViewBag.Regions as SelectList)?.FirstOrDefault(r => r.Selected)?.Text;
    var difficultyName = difficulties?.FirstOrDefault(d => d.Selected)?.Text;
    var tagName = tags.FirstOrDefault(t => t.Id == filter.TagId)?.Name;
    var hasFilters = !string.IsNullOrWhiteSpace(filter.Q) || filter.RegionId.HasValue || filter.DifficultyId.HasValue || filter.TagId.HasValue;
    var baseRoute = isLive ? new Dictionary<string, string> { ["lat"] = tagRoute["lat"], ["lng"] = tagRoute["lng"] } : new Dictionary<string, string>();
    if (sort != "newest") baseRoute["sort"] = sort;

    // link that keeps every current filter except the one named
    Dictionary<string, string> Without(string key)
    {
        var r = new Dictionary<string, string>(pageRoute);
        r.Remove(key);
        return r;
    }
    Dictionary<string, string> WithDifficulty(int? id)
    {
        var r = Without("difficultyId");
        if (id.HasValue) r["difficultyId"] = id.Value.ToString();
        return r;
    }
    const int visibleTags = 12;
}

<div class="tl-head">
    <div>
        <p class="eyebrow mb-1">ALL TRAILS</p>
        <h1 class="mb-1">Discover trails</h1>
        <p class="text-muted mb-0">
            @totalCount @(totalCount == 1 ? "trail" : "trails")@(hasFilters ? " match" : "")
            @if (located)
            {
                <span class="tl-loc">
                    <i class="ti ti-current-location"></i>
                    @if (isLive) { <text>nearest to you first</text> }
                    else { <text>nearest to @(string.IsNullOrEmpty(homeName) ? "your home" : homeName) first</text> <a asp-controller="Manage" asp-action="Index">Change</a> }
                </span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (isLive)
        {
            <a class="btn-ascent-outline" asp-action="Index"><i class="ti ti-x"></i> Clear location</a>
        }
        else
        {
            <button id="uselocation" type="button" class="btn-ascent-outline"><i class="ti ti-navigation"></i> Use my location</button>
        }
        @if (User.IsInRole("Guide") || User.IsInRole("Admin"))
        {
            <a class="btn-ascent" asp-action="Create"><i class="ti ti-plus"></i> Add trail</a>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="tl-search glass" id="trailSearch">
    @if (filter.TagId.HasValue) { <input type="hidden" name="tagId" value="@filter.TagId" /> }
    @if (filter.DifficultyId.HasValue) { <input type="hidden" name="difficultyId" value="@filter.DifficultyId" /> }
    @if (isLive)
    {
        <input type="hidden" name="lat" value="@tagRoute["lat"]" />
        <input type="hidden" name="lng" value="@tagRoute["lng"]" />
    }

    <label class="tl-searchbar">
        <i class="ti ti-search"></i>
        <input type="search" name="q" value="@filter.Q" placeholder="Search trails, peaks, regions or tags" autocomplete="off" />
        <button type="submit" class="btn-ascent">Search</button>
    </label>

    <div class="tl-filters">
        <div class="tl-seg" role="group" aria-label="Difficulty">
            <a class="@(filter.DifficultyId.HasValue ? "" : "on")" asp-action="Index" asp-all-route-data="WithDifficulty(null)">Any difficulty</a>
            @if (difficulties != null)
            {
                foreach (var d in difficulties)
                {
                    <a class="@(d.Selected ? "on" : "")" data-diff="@d.Text.ToLowerInvariant()" asp-action="Index" asp-all-route-data="WithDifficulty(int.Parse(d.Value))">@d.Text</a>
                }
            }
        </div>
        <div class="tl-selects">
            <select name="regionId" class="form-select" asp-items="ViewBag.Regions" data-autosubmit aria-label="Region">
                <option value="">All regions</option>
            </select>
            <select name="sort" class="form-select" data-autosubmit aria-label="Sort">
                @foreach (var (val, text) in sortOptions)
                {
                    <option value="@val" selected="@(sort == val)">@text</option>
                }
            </select>
        </div>
    </div>

    @if (tags.Any())
    {
        <div class="tl-tags collapsed" id="tlTags">
            @foreach (var tag in tags)
            {
                var active = filter.TagId == tag.Id;
                var route = Without("tagId");
                if (!active) route["tagId"] = tag.Id.ToString();
                <a class="asc-chip @(active ? "active" : "")" asp-action="Index" asp-all-route-data="route">@tag.Name</a>
            }
            @if (tags.Count > visibleTags)
            {
                <button type="button" class="tl-tags-more" id="tlTagsMore" data-more="All @tags.Count tags" data-less="Fewer tags">All @tags.Count tags</button>
            }
        </div>
    }

    @if (hasFilters)
    {
        <div class="tl-active">
            <span class="text-muted">Filtering by</span>
            @if (!string.IsNullOrWhiteSpace(filter.Q)) { <a class="tl-crumb" asp-action="Index" asp-all-route-data='Without("q")'>“@filter.Q” <i class="ti ti-x"></i></a> }
            @if (regionName != null) { <a class="tl-crumb" asp-action="Index" asp-all-route-data='Without("regionId")'>@regionName <i class="ti ti-x"></i></a> }
            @if (difficultyName != null) { <a class="tl-crumb" asp-action="Index" asp-all-route-data='Without("difficultyId")'>@difficultyName <i class="ti ti-x"></i></a> }
            @if (tagName != null) { <a class="tl-crumb" asp-action="Index" asp-all-route-data='Without("tagId")'>@tagName <i class="ti ti-x"></i></a> }
            <a class="tl-clear" asp-action="Index" asp-all-route-data="baseRoute">Clear all</a>
        </div>
    }
</form>

<div class="trails-layout" id="trailsLayout">
    <div class="trails-main">
        <div class="results-bar">
            <p class="text-muted mb-0" style="font-size:13px">@(totalPages > 1 ? $"Page {currentPage} of {totalPages}" : "")</p>
            @if (totalCount > 0)
            {
                <button type="button" id="toggleMap" class="btn-ascent-outline" style="padding:6px 12px;font-size:13px">
                    <i class="ti ti-map"></i> <span data-maplabel>Hide map</span>
                </button>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="asc-panel text-center text-muted my-4">
                <i class="ti ti-mountain" style="font-size:32px;opacity:.5"></i>
                <p class="mb-2 mt-2">No trails match these filters.</p>
                <a class="btn-ascent-outline" asp-action="Index" asp-all-route-data="baseRoute">Clear all filters</a>
            </div>
        }
        else
        {
            <div class="trail-grid">
                @foreach (var trail in Model)
                {
                    <partial name="_TrailCard" model="trail" />
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mt-4">
                    @if (currentPage > 1)
                    {
                        var prev = new Dictionary<string, string>(pageRoute) { ["page"] = (currentPage - 1).ToString() };
                        <a class="btn-ascent-outline" asp-action="Index" asp-all-route-data="prev"><i class="ti ti-chevron-left"></i> Prev</a>
                    }
                    @for (var i = 1; i <= totalPages; i++)
                    {
                        var pg = new Dictionary<string, string>(pageRoute) { ["page"] = i.ToString() };
                        <a class="asc-chip @(i == currentPage ? "active" : "")" asp-action="Index" asp-all-route-data="pg">@i</a>
                    }
                    @if (currentPage < totalPages)
                    {
                        var next = new Dictionary<string, string>(pageRoute) { ["page"] = (currentPage + 1).ToString() };
                        <a class="btn-ascent-outline" asp-action="Index" asp-all-route-data="next">Next <i class="ti ti-chevron-right"></i></a>
                    }
                </div>
            }
        }
    </div>

    @if (totalCount > 0)
    {
        <aside class="trails-aside" id="trailsAside">
            <div class="map-side-head">
                <p class="eyebrow mb-0"><i class="ti ti-map-2"></i> Map</p>
                <span class="text-muted" style="font-size:11px">Drag to rotate · Ctrl+scroll to zoom</span>
            </div>
            <div id="overviewmap" class="map-side"></div>
        </aside>
    }
</div>

@section Styles {
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
}

@section Scripts {
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script src="~/js/ascent-map.js" asp-append-version="true"></script>
    <script>
        const trails = @Html.Raw(mapTrails);
        const user = @(located ? Html.Raw($"[{userLng!.Value.ToString(inv)}, {userLat!.Value.ToString(inv)}]") : Html.Raw("null"));
        const userLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isLive ? "You are here" : (string.IsNullOrEmpty(homeName) ? "Your home" : $"Your home — {homeName}")));
        const focus = [@focusLng.ToString(inv), @focusLat.ToString(inv)];
        const focusZoom = @focusZoom.ToString(inv);
        const el = document.getElementById('overviewmap');
        let overviewMap = null;
        if (el && trails.length) {
            overviewMap = AscentMap.display('overviewmap', { center: focus, zoom: focusZoom, pitch: 40, cooperative: true });
            AscentMap.onReady(overviewMap, () => {
                trails.forEach(t => {
                    AscentMap.addRoute(overviewMap, t.route, { color: AscentMap.colorFor(t.diff), width: 3 });
                    const popup = '<a href="' + t.url + '"><strong>' + t.name + '</strong></a>';
                    AscentMap.marker(overviewMap, [t.lng, t.lat], { color: AscentMap.colorFor(t.diff), popup: popup });
                });
                if (user) AscentMap.marker(overviewMap, user, { color: AscentMap.TERRACOTTA, popup: userLabel });
            });
        }

        const layout = document.getElementById('trailsLayout');
        const toggle = document.getElementById('toggleMap');
        if (layout && toggle) {
            const label = toggle.querySelector('[data-maplabel]');
            const apply = hidden => {
                layout.classList.toggle('map-hidden', hidden);
                if (label) label.textContent = hidden ? 'Show map' : 'Hide map';
                if (!hidden && overviewMap) setTimeout(() => overviewMap.resize(), 50);
            };
            apply(localStorage.getItem('ascentMapHidden') === '1');
            toggle.addEventListener('click', () => {
                const hidden = !layout.classList.contains('map-hidden');
                localStorage.setItem('ascentMapHidden', hidden ? '1' : '0');
                apply(hidden);
            });
        }

        document.querySelectorAll('#trailSearch [data-autosubmit]').forEach(sel =>
            sel.addEventListener('change', () => sel.form.submit()));
        const tagsBox = document.getElementById('tlTags'), tagsMore = document.getElementById('tlTagsMore');
        if (tagsBox && tagsMore) {
            if (tagsBox.querySelector('.asc-chip.active') && [...tagsBox.children].indexOf(tagsBox.querySelector('.asc-chip.active')) >= 12)
                tagsBox.classList.remove('collapsed');
            tagsMore.textContent = tagsBox.classList.contains('collapsed') ? tagsMore.dataset.more : tagsMore.dataset.less;
            tagsMore.addEventListener('click', () => {
                tagsBox.classList.toggle('collapsed');
                tagsMore.textContent = tagsBox.classList.contains('collapsed') ? tagsMore.dataset.more : tagsMore.dataset.less;
            });
        }

        const locBtn = document.getElementById('uselocation');
        if (locBtn) {
            locBtn.addEventListener('click', () => {
                if (!navigator.geolocation) { alert('Geolocation is not supported by your browser.'); return; }
                locBtn.disabled = true;
                locBtn.innerHTML = '<i class="ti ti-loader"></i> Locating…';
                navigator.geolocation.getCurrentPosition(
                    pos => {
                        const u = new URL(window.location);
                        u.searchParams.set('lat', pos.coords.latitude);
                        u.searchParams.set('lng', pos.coords.longitude);
                        u.searchParams.set('sort', 'nearest');
                        u.searchParams.delete('page');
                        window.location = u;
                    },
                    () => {
                        alert('Could not get your location.');
                        locBtn.disabled = false;
                        locBtn.innerHTML = '<i class="ti ti-navigation"></i> Use my location';
                    });
            });
        }
    </script>
}
