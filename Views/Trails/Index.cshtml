@using ascent_app.Models
@using ascent_app.ViewModels
@model IEnumerable<ascent_app.Models.Trail>

@{
    ViewData["Title"] = "Trails";
    var mapTrails = ViewBag.MapTrails as string ?? "[]";
    var filter = ViewBag.Filter as TrailFilterViewModel ?? new TrailFilterViewModel();
    var tags = ViewBag.Tags as List<Tag> ?? new List<Tag>();
    var sort = ViewBag.Sort as string ?? "newest";
    var currentPage = ViewBag.Page is int p ? p : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 0;
    var totalCount = ViewBag.TotalCount is int tc ? tc : Model.Count();

    var userLat = ViewBag.UserLat as double?;
    var userLng = ViewBag.UserLng as double?;
    var located = userLat.HasValue && userLng.HasValue;

    var sortOptions = new List<(string, string)>();
    if (located) sortOptions.Add(("nearest", "Nearest to me"));
    sortOptions.AddRange(new[]
    {
        ("newest", "Newest"),
        ("name", "Name"),
        ("distance", "Distance"),
        ("elevation", "Elevation"),
        ("rating", "Rating"),
    });

    // preserve the non-tag filters when building tag chip links
    var tagRoute = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(filter.Q)) tagRoute["q"] = filter.Q!;
    if (filter.RegionId.HasValue) tagRoute["regionId"] = filter.RegionId.Value.ToString();
    if (filter.DifficultyId.HasValue) tagRoute["difficultyId"] = filter.DifficultyId.Value.ToString();
    if (sort != "newest") tagRoute["sort"] = sort;
    // keep the visitor's location pinned across every filter/sort/page link
    if (located)
    {
        tagRoute["lat"] = userLat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        tagRoute["lng"] = userLng!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    // full active filter set for pager links (every param except page)
    var pageRoute = new Dictionary<string, string>(tagRoute);
    if (filter.TagId.HasValue) pageRoute["tagId"] = filter.TagId.Value.ToString();
}

<div class="d-flex align-items-end justify-content-between mt-4 mb-3">
    <div>
        <p class="eyebrow mb-1">ALL TRAILS</p>
        <h1 class="mb-0">Discover trails</h1>
    </div>
    <div class="d-flex gap-2">
        @if (located)
        {
            <a class="btn-ascent-outline" asp-action="Index"><i class="ti ti-x"></i> Clear location</a>
        }
        else
        {
            <button id="uselocation" type="button" class="btn-ascent-outline"><i class="ti ti-navigation"></i> Use my location</button>
        }
        @if (User.IsInRole("Guide") || User.IsInRole("Admin"))
        {
            <a class="btn-ascent" asp-action="Create"><i class="ti ti-plus"></i> Add trail</a>
        }
    </div>
</div>

@if (located)
{
    <div class="asc-panel mb-3 d-flex align-items-center gap-2" style="padding:10px 14px">
        <i class="ti ti-current-location" style="color:var(--terracotta)"></i>
        <span style="font-size:14px">Showing trails <strong>nearest to you</strong> first — closest at the top.</span>
    </div>
}

<form asp-action="Index" method="get" class="asc-panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md">
            <label class="eyebrow mb-1">Search</label>
            <input type="text" name="q" value="@filter.Q" class="form-control" placeholder="Search trails…" />
        </div>
        <div class="col-6 col-md-auto">
            <label class="eyebrow mb-1">Region</label>
            <select name="regionId" class="form-select" asp-items="ViewBag.Regions">
                <option value="">All regions</option>
            </select>
        </div>
        <div class="col-6 col-md-auto">
            <label class="eyebrow mb-1">Difficulty</label>
            <select name="difficultyId" class="form-select" asp-items="ViewBag.Difficulties">
                <option value="">All</option>
            </select>
        </div>
        @* keep the active tag selection across a search/region/difficulty submit *@
        @if (filter.TagId.HasValue)
        {
            <input type="hidden" name="tagId" value="@filter.TagId" />
        }
        @* keep the visitor's location across a filter submit *@
        @if (located)
        {
            <input type="hidden" name="lat" value="@tagRoute["lat"]" />
            <input type="hidden" name="lng" value="@tagRoute["lng"]" />
        }
        <div class="col-6 col-md-auto">
            <label class="eyebrow mb-1">Sort</label>
            <select name="sort" class="form-select">
                @foreach (var (val, text) in sortOptions)
                {
                    <option value="@val" selected="@(sort == val)">@text</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn-ascent">Filter</button>
            @{ var clearRoute = located ? new Dictionary<string, string> { ["lat"] = tagRoute["lat"], ["lng"] = tagRoute["lng"] } : new Dictionary<string, string>(); }
            <a class="btn-ascent-outline" asp-action="Index" asp-all-route-data="clearRoute">Clear</a>
        </div>
    </div>

    @if (tags.Any())
    {
        <div class="d-flex flex-wrap gap-2 mt-3">
            @foreach (var tag in tags)
            {
                var active = filter.TagId == tag.Id;
                var route = new Dictionary<string, string>(tagRoute);
                if (!active) route["tagId"] = tag.Id.ToString();
                <a class="asc-chip @(active ? "active" : "")" asp-action="Index" asp-all-route-data="route">@tag.Name</a>
            }
        </div>
    }
</form>

@if (totalCount > 0)
{
    <div class="asc-panel mb-3" style="padding:14px">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <p class="eyebrow mb-0"><i class="ti ti-map-2"></i> EXPLORE ON THE MAP</p>
            <span class="text-muted" style="font-size:12px">
                <i class="ti ti-hand-finger"></i> Drag to pan · right-drag to tilt · Ctrl+scroll to zoom · click a pin to open
            </span>
        </div>
        <div id="overviewmap" class="map-box"></div>
    </div>
}

<p class="text-muted mb-3">Showing @Model.Count() of @totalCount @(totalCount == 1 ? "trail" : "trails")</p>

@if (!Model.Any())
{
    <div class="asc-panel text-center text-muted my-4">
        <i class="ti ti-mountain" style="font-size:32px;opacity:.5"></i>
        <p class="mb-0 mt-2">No trails match your filters.</p>
    </div>
}
else
{
    <div class="trail-grid">
        @foreach (var trail in Model)
        {
            <partial name="_TrailCard" model="trail" />
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mt-4">
            @if (currentPage > 1)
            {
                var prev = new Dictionary<string, string>(pageRoute) { ["page"] = (currentPage - 1).ToString() };
                <a class="btn-ascent-outline" asp-action="Index" asp-all-route-data="prev"><i class="ti ti-chevron-left"></i> Prev</a>
            }
            @for (var i = 1; i <= totalPages; i++)
            {
                var pg = new Dictionary<string, string>(pageRoute) { ["page"] = i.ToString() };
                <a class="asc-chip @(i == currentPage ? "active" : "")" asp-action="Index" asp-all-route-data="pg">@i</a>
            }
            @if (currentPage < totalPages)
            {
                var next = new Dictionary<string, string>(pageRoute) { ["page"] = (currentPage + 1).ToString() };
                <a class="btn-ascent-outline" asp-action="Index" asp-all-route-data="next">Next <i class="ti ti-chevron-right"></i></a>
            }
        </div>
    }
}

@section Styles {
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
}

@section Scripts {
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script src="~/js/ascent-map.js" asp-append-version="true"></script>
    <script>
        const trails = @Html.Raw(mapTrails);
        // the visitor's shared location ([lng, lat] for MapLibre), or null
        const user = @(located ? Html.Raw($"[{userLng!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}, {userLat!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}]") : Html.Raw("null"));
        const el = document.getElementById('overviewmap');
        if (el && trails.length) {
            const map = AscentMap.display('overviewmap', { pitch: 45, cooperative: true });
            AscentMap.onReady(map, () => {
                const all = [];
                trails.forEach(t => {
                    // colour each route by difficulty; fall back to a pin when there's no route
                    const coords = AscentMap.addRoute(map, t.route, { color: AscentMap.colorFor(t.diff), width: 3 });
                    const popup = '<a href="' + t.url + '"><strong>' + t.name + '</strong></a>';
                    AscentMap.marker(map, [t.lng, t.lat], { color: AscentMap.colorFor(t.diff), popup: popup });
                    (coords || [[t.lng, t.lat]]).forEach(c => all.push(c));
                });
                if (user) {
                    AscentMap.marker(map, user, { color: AscentMap.TERRACOTTA, popup: 'You are here' });
                    all.push(user);
                }
                AscentMap.fit(map, all, { padding: 50, pitch: 45 });
            });
        }

        // "Use my location": geolocate, then reload keeping current filters + sort by nearest
        const locBtn = document.getElementById('uselocation');
        if (locBtn) {
            locBtn.addEventListener('click', () => {
                if (!navigator.geolocation) { alert('Geolocation is not supported by your browser.'); return; }
                locBtn.disabled = true;
                locBtn.innerHTML = '<i class="ti ti-loader"></i> Locating…';
                navigator.geolocation.getCurrentPosition(
                    pos => {
                        const u = new URL(window.location);
                        u.searchParams.set('lat', pos.coords.latitude);
                        u.searchParams.set('lng', pos.coords.longitude);
                        u.searchParams.set('sort', 'nearest');
                        u.searchParams.delete('page');
                        window.location = u;
                    },
                    () => {
                        alert('Could not get your location.');
                        locBtn.disabled = false;
                        locBtn.innerHTML = '<i class="ti ti-navigation"></i> Use my location';
                    });
            });
        }
    </script>
}
