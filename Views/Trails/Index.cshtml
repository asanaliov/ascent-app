@using ascent_app.Models
@using ascent_app.ViewModels
@model IEnumerable<ascent_app.Models.Trail>

@{
    ViewData["Title"] = "Trails";
    var filter = ViewBag.Filter as TrailFilterViewModel ?? new TrailFilterViewModel();
    var tags = ViewBag.Tags as List<Tag> ?? new List<Tag>();

    // preserve the non-tag filters when building tag chip links
    var tagRoute = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(filter.Q)) tagRoute["q"] = filter.Q!;
    if (filter.RegionId.HasValue) tagRoute["regionId"] = filter.RegionId.Value.ToString();
    if (filter.DifficultyId.HasValue) tagRoute["difficultyId"] = filter.DifficultyId.Value.ToString();
}

<div class="d-flex align-items-end justify-content-between mt-4 mb-3">
    <div>
        <p class="eyebrow mb-1">ALL TRAILS</p>
        <h1 class="mb-0">Discover trails</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn-ascent-outline" asp-action="Nearby"><i class="ti ti-navigation"></i> Near me</a>
        @if (User.IsInRole("Guide") || User.IsInRole("Admin"))
        {
            <a class="btn-ascent" asp-action="Create"><i class="ti ti-plus"></i> Add trail</a>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="asc-panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md">
            <label class="eyebrow mb-1">Search</label>
            <input type="text" name="q" value="@filter.Q" class="form-control" placeholder="Search trails…" />
        </div>
        <div class="col-6 col-md-auto">
            <label class="eyebrow mb-1">Region</label>
            <select name="regionId" class="form-select" asp-items="ViewBag.Regions">
                <option value="">All regions</option>
            </select>
        </div>
        <div class="col-6 col-md-auto">
            <label class="eyebrow mb-1">Difficulty</label>
            <select name="difficultyId" class="form-select" asp-items="ViewBag.Difficulties">
                <option value="">All</option>
            </select>
        </div>
        @* keep the active tag selection across a search/region/difficulty submit *@
        @if (filter.TagId.HasValue)
        {
            <input type="hidden" name="tagId" value="@filter.TagId" />
        }
        <div class="col-12 col-md-auto">
            <button type="submit" class="btn-ascent">Filter</button>
            <a class="btn-ascent-outline" asp-action="Index">Clear</a>
        </div>
    </div>

    @if (tags.Any())
    {
        <div class="d-flex flex-wrap gap-2 mt-3">
            @foreach (var tag in tags)
            {
                var active = filter.TagId == tag.Id;
                var route = new Dictionary<string, string>(tagRoute);
                if (!active) route["tagId"] = tag.Id.ToString();
                <a class="asc-chip @(active ? "active" : "")" asp-action="Index" asp-all-route-data="route">@tag.Name</a>
            }
        </div>
    }
</form>

<p class="text-muted mb-3">@Model.Count() @(Model.Count() == 1 ? "trail" : "trails")</p>

@if (!Model.Any())
{
    <div class="asc-panel text-center text-muted my-4">
        <i class="ti ti-mountain" style="font-size:32px;opacity:.5"></i>
        <p class="mb-0 mt-2">No trails match your filters.</p>
    </div>
}
else
{
    <div class="trail-grid">
        @foreach (var trail in Model)
        {
            <partial name="_TrailCard" model="trail" />
        }
    </div>
}
