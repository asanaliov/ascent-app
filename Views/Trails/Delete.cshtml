@model ascent_app.Models.Trail

@{
    ViewData["Title"] = "Delete trail";
    var diffClass = (Model.Difficulty?.Label ?? "").ToLowerInvariant();
}

<div class="auth-wrap">
    <p class="eyebrow mb-1">CONFIRM DELETE</p>
    <h1 class="mb-3">Delete this trail?</h1>

    <div class="asc-panel mb-3">
        <div class="tc-region"><i class="ti ti-map-pin"></i> @Model.Region?.Name</div>
        <h3 class="tc-title d-inline-flex align-items-center gap-2">
            @Model.Name
            @if (Model.Difficulty is not null)
            {
                <span class="diff-inline diff-@diffClass">@Model.Difficulty.Label</span>
            }
        </h3>
        <p class="text-secondary mb-2">@Model.ShortDescription</p>
        <div class="tc-stats">
            <span><i class="ti ti-route"></i> @Model.DistanceKm km</span>
            <span><i class="ti ti-mountain"></i> @Model.ElevationGainM m</span>
        </div>
    </div>

    <p class="text-muted" style="font-size:13px">This action cannot be undone.</p>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn-ascent" style="background:var(--terracotta);border-color:var(--terracotta)">
                <i class="ti ti-trash"></i> Delete trail
            </button>
            <a class="btn-ascent-outline" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
