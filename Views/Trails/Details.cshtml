@model ascent_app.Models.Trail
@using Microsoft.AspNetCore.Identity
@using ascent_app.Models
@using ascent_app.Services
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Name;
    var diffClass = (Model.Difficulty?.Label ?? "").ToLowerInvariant();
    var canManage = User.IsInRole("Guide") || User.IsInRole("Admin");
    var isAdmin = User.IsInRole("Admin");

    var reviews = Model.Reviews.OrderByDescending(r => r.CreatedAt).ToList();
    var avg = Model.AverageRating;
    var myId = UserManager.GetUserId(User);
    var myReview = myId is null ? null : reviews.FirstOrDefault(r => r.UserId == myId);
    var advice = ViewBag.Advice as TrailAdvice;
}

<a class="asc-nav-link d-inline-flex align-items-center gap-1 mt-4" asp-action="Index">
    <i class="ti ti-arrow-left"></i> Back to trails
</a>

<div class="d-flex align-items-end justify-content-between mt-2 mb-3">
    <div>
        <div class="tc-region"><i class="ti ti-map-pin"></i> @Model.Region?.Name</div>
        <h1 class="mb-0 d-inline-flex align-items-center gap-2">
            @Model.Name
            @if (Model.Difficulty is not null)
            {
                <span class="diff-inline diff-@diffClass">@Model.Difficulty.Label</span>
            }
        </h1>
        <div class="rating-line mt-1">
            @for (var i = 1; i <= 5; i++)
            {
                <i class="ti ti-star @(i <= Math.Round(avg) ? "on" : "off")"></i>
            }
            @if (reviews.Count > 0)
            {
                <span class="rating-text">@avg.ToString("0.0") · @reviews.Count review@(reviews.Count == 1 ? "" : "s")</span>
            }
            else
            {
                <span class="rating-text">No reviews yet</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <partial name="_FavoriteButton" model="Model" />
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn-ascent" asp-controller="HikeLogs" asp-action="Create" asp-route-trailId="@Model.Id">
                <i class="ti ti-plus"></i> Log this hike
            </a>
        }
        @if (canManage)
        {
            <a class="btn-ascent-outline" asp-action="Edit" asp-route-id="@Model.Id"><i class="ti ti-edit"></i> Edit</a>
            <a class="btn-ascent-outline" asp-action="Delete" asp-route-id="@Model.Id"><i class="ti ti-trash"></i> Delete</a>
        }
    </div>
</div>

@{
    var images = Model.Photos
        .OrderByDescending(p => p.IsCoverImage)
        .ThenBy(p => p.Id)
        .Select(p => p.Url)
        .ToList();
    if (!string.IsNullOrEmpty(Model.PhotoUrl) && !images.Contains(Model.PhotoUrl))
        images.Add(Model.PhotoUrl);
    if (images.Count == 0)
        images.Add("/images/trails/default-trail.svg");
}

<div class="trail-hero">
    <div>
        <div class="gallery-main">
            <img id="galleryMain"
                 src="@images[0]"
                 alt="@Model.Name"
                 onerror="this.onerror=null;this.src='/images/trails/default-trail.svg';">
            @if (Model.Difficulty is not null)
            {
                <span class="diff-badge diff-@diffClass">@Model.Difficulty.Label</span>
            }
        </div>
        @if (images.Count > 1)
        {
            <div class="gallery-thumbs">
                @for (var i = 0; i < images.Count; i++)
                {
                    <button type="button" class="gallery-thumb @(i == 0 ? "active" : "")" data-src="@images[i]" aria-label="Show photo @(i + 1)">
                        <img src="@images[i]"
                             alt=""
                             onerror="this.onerror=null;this.src='/images/trails/default-trail.svg';">
                    </button>
                }
            </div>
        }
    </div>

    <aside class="asc-panel facts-card">
        <div class="facts-list">
            <div class="row-item">
                <span class="k"><i class="ti ti-route"></i> Distance</span>
                <span class="v">@Model.DistanceKm km</span>
            </div>
            <div class="row-item">
                <span class="k"><i class="ti ti-mountain"></i> Elevation gain</span>
                <span class="v">@Model.ElevationGainM m</span>
            </div>
            <div class="row-item">
                <span class="k"><i class="ti ti-clock"></i> Estimated time</span>
                <span class="v">@Model.EstimatedTimeHours.ToString("0.#") hours</span>
            </div>
            <div class="row-item">
                <span class="k"><i class="ti ti-chart-line"></i> Difficulty</span>
                <span class="v"><span class="diff-inline diff-@diffClass">@(Model.Difficulty?.Label ?? "—")</span></span>
            </div>
            <div class="row-item">
                <span class="k"><i class="ti ti-map-pin"></i> Region</span>
                <span class="v" style="text-align:right;font-size:15px">
                    @(Model.Region?.Name ?? "—")
                    @if (!string.IsNullOrEmpty(Model.Region?.Country))
                    {
                        <span class="d-block text-muted" style="font-size:12px;font-family:var(--font-body)">@Model.Region.Country</span>
                    }
                </span>
            </div>
            <div class="row-item">
                <span class="k"><i class="ti ti-current-location"></i> Trailhead</span>
                <span class="v" style="font-size:14px;font-family:var(--font-body)">@Model.Latitude.ToString("0.000"), @Model.Longitude.ToString("0.000")</span>
            </div>
        </div>
        <a class="asc-nav-link mt-3 d-inline-flex align-items-center gap-1" asp-action="Index">
            <i class="ti ti-navigation"></i> Find trails near you
        </a>
    </aside>
</div>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <p class="eyebrow mb-0"><i class="ti ti-route"></i> ROUTE</p>
    @if (!string.IsNullOrEmpty(Model.RouteGeoJson))
    {
        <div class="map-actions">
            <span class="text-muted me-1" style="font-size:13px">
                <i class="ti ti-map-pin-filled" style="color:var(--forest)"></i> Trailhead
                &nbsp;<i class="ti ti-flag" style="color:var(--terracotta)"></i> Summit
            </span>
            <button id="simbtn" type="button" class="btn-play">
                <i class="ti ti-player-play-filled"></i> Play
            </button>
            <button id="followbtn" type="button" class="btn-follow">
                <i class="ti ti-drone"></i> Follow route
            </button>
            <div class="speed-group" id="speedGroup" role="group" aria-label="Playback speed">
                <button type="button" class="speed-opt active" data-speed="1">1×</button>
                <button type="button" class="speed-opt" data-speed="2">2×</button>
                <button type="button" class="speed-opt" data-speed="3">3×</button>
                <button type="button" class="speed-opt" data-speed="5">5×</button>
            </div>
        </div>
    }
</div>
<div id="routemap" class="map-box mb-2"></div>
<p class="text-muted mb-4" style="font-size:12px">
    <i class="ti ti-rotate-360"></i> Right-drag (or the compass) to rotate &amp; tilt · Ctrl+scroll to zoom
</p>

<div class="row">
    <div class="col-md-9">
        <p class="eyebrow mb-2">ABOUT THIS TRAIL</p>
        <p class="lead" style="font-size:16px">@Model.ShortDescription</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-secondary">@Model.Description</p>
        }
        <p class="text-muted" style="font-size:12px">
            <i class="ti ti-database"></i> Source: @Model.Source
        </p>
        @if (Model.TrailTags.Any())
        {
            <div class="d-flex gap-2 flex-wrap mt-2">
                @foreach (var tt in Model.TrailTags.OrderBy(x => x.Tag.Name))
                {
                    <span class="asc-chip"><i class="ti ti-tag"></i> @tt.Tag.Name</span>
                }
            </div>
        }
    </div>
</div>

@if (advice is not null)
{
    <div class="row g-3 mt-2">
        <div class="col-md-5">
            <div class="asc-panel h-100">
                <p class="eyebrow mb-2"><i class="ti ti-chart-dots"></i> BY THE NUMBERS</p>
                <div class="facts-list">
                    @foreach (var f in advice.Facts)
                    {
                        <div class="row-item">
                            <span class="k"><i class="ti @f.Icon"></i> @f.Label</span>
                            <span class="v">@f.Value</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="asc-panel h-100">
                <p class="eyebrow mb-2"><i class="ti ti-backpack"></i> BEFORE YOU GO</p>
                <ul class="advice-list">
                    @foreach (var tip in advice.Tips)
                    {
                        <li><i class="ti @tip.Icon"></i><span>@tip.Text</span></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

@if (canManage)
{
    <div class="asc-panel mt-4">
        <p class="eyebrow mb-2"><i class="ti ti-photo"></i> MANAGE PHOTOS</p>
        <p class="text-muted mb-3" style="font-size:13px">Photos you add appear in the gallery at the top of the page.</p>

        @if (TempData["TrailPhotoError"] is string photoError)
        {
            <div class="asc-panel mb-3" style="border-color:var(--terracotta)">
                <i class="ti ti-alert-triangle" style="color:var(--terracotta)"></i> @photoError
            </div>
        }

        @if (Model.Photos.Any())
        {
            <div class="photo-strip">
                @foreach (var p in Model.Photos)
                {
                    <figure class="photo-thumb">
                        <img src="@p.Url"
                             alt="@(p.Caption ?? Model.Name)"
                             onerror="this.onerror=null;this.src='/images/trails/default-trail.svg';" />
                        @if (canManage)
                        {
                            <form asp-controller="TrailPhotos" asp-action="Delete" asp-route-id="@p.Id" method="post"
                                  onsubmit="return confirm('Delete this photo?');">
                                <button type="submit" class="photo-del" title="Delete photo"><i class="ti ti-x"></i></button>
                            </form>
                        }
                        @if (!string.IsNullOrWhiteSpace(p.Caption))
                        {
                            <figcaption>@p.Caption</figcaption>
                        }
                    </figure>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0" style="font-size:14px">No photos yet — add the first one below.</p>
        }

        @if (canManage)
        {
            <form asp-controller="TrailPhotos" asp-action="Add" method="post" enctype="multipart/form-data"
                  class="d-flex gap-2 align-items-center mt-3 flex-wrap">
                <input type="hidden" name="trailId" value="@Model.Id" />
                <input type="file" name="photoFile" accept="image/png,image/jpeg,image/webp"
                       class="form-control form-control-sm" style="max-width:240px" required />
                <input type="text" name="caption" placeholder="Caption (optional)"
                       class="form-control form-control-sm" style="max-width:200px" maxlength="200" />
                <button type="submit" class="btn-ascent-outline" style="padding:6px 12px;font-size:13px">
                    <i class="ti ti-camera-plus"></i> Add photo
                </button>
            </form>
        }
    </div>
}

<div class="meta-row mt-4">
    <span>
        <i class="ti ti-user"></i> Added by
        @if (Model.Author != null)
        {
            <a asp-controller="Profile" asp-action="Index" asp-route-id="@Model.Author.Id">@Model.Author.DisplayName</a>
        }
        else
        {
            @:—
        }
    </span>
    <span><i class="ti ti-calendar"></i> @Model.CreatedAt.ToString("MMM d, yyyy")</span>
</div>

<hr class="my-4" />

<div class="row">
    <div class="col-md-7">
        <p class="eyebrow mb-3">REVIEWS</p>

        @if (reviews.Count == 0)
        {
            <p class="text-muted" style="font-size:14px">Be the first to review this trail.</p>
        }
        else
        {
            foreach (var review in reviews)
            {
                <div class="review-item mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="review-author">
                                @if (review.User != null)
                                {
                                    <a asp-controller="Profile" asp-action="Index" asp-route-id="@review.User.Id">@review.User.DisplayName</a>
                                }
                                else
                                {
                                    @:Hiker
                                }
                            </span>
                            <span class="review-stars">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="ti ti-star @(i <= review.Rating ? "on" : "off")"></i>
                                }
                            </span>
                        </div>
                        @if (review.UserId == myId || isAdmin)
                        {
                            <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.Id"
                                  method="post" onsubmit="return confirm('Delete this review?');">
                                <button type="submit" class="review-del" title="Delete review">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="mb-1 mt-1" style="font-size:14px">@review.Comment</p>
                    }
                    <div class="text-muted" style="font-size:12px">@review.CreatedAt.ToString("MMM d, yyyy")</div>
                </div>
            }
        }
    </div>

    <div class="col-md-5">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="asc-panel">
                <p class="eyebrow mb-2">@(myReview is null ? "WRITE A REVIEW" : "UPDATE YOUR REVIEW")</p>

                @if (TempData["ReviewError"] is string reviewError)
                {
                    <p class="text-danger" style="font-size:13px">@reviewError</p>
                }

                <form asp-controller="Reviews" asp-action="Create" method="post">
                    <input type="hidden" name="TrailId" value="@Model.Id" />

                    <div class="mb-2">
                        <label class="form-label">Rating</label>
                        <select name="Rating" class="form-select">
                            @for (var i = 5; i >= 1; i--)
                            {
                                var selected = (myReview?.Rating ?? 5) == i;
                                <option value="@i" selected="@selected">@i star@(i == 1 ? "" : "s")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Comment <span class="text-muted">(optional)</span></label>
                        <textarea name="Comment" class="form-control" rows="3" maxlength="1000">@myReview?.Comment</textarea>
                    </div>
                    <button type="submit" class="btn-ascent">
                        @(myReview is null ? "Post review" : "Update review")
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="asc-panel text-center">
                <p class="mb-2" style="font-size:14px">Sign in to leave a review.</p>
                <a class="btn-ascent" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Trails", new { id = Model.Id })">
                    <i class="ti ti-user"></i> Sign in
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
}

@section Scripts {
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script src="~/js/ascent-map.js" asp-append-version="true"></script>
    <script>
        (function () {
            const main = document.getElementById('galleryMain');
            const thumbs = document.querySelectorAll('.gallery-thumb');
            thumbs.forEach(t => t.addEventListener('click', () => {
                if (!main) return;
                main.src = t.dataset.src;
                thumbs.forEach(x => x.classList.remove('active'));
                t.classList.add('active');
            }));
        })();

        const lat = @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const lng = @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const name = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name));
        const route = @Html.Raw(string.IsNullOrWhiteSpace(Model.RouteGeoJson) ? "null" : Model.RouteGeoJson);

        const map = AscentMap.display('routemap', { center: [lng, lat], zoom: 12, pitch: 60, bearing: -18, cooperative: true });
        AscentMap.onReady(map, () => {
            AscentMap.setBasemap(map, 'bm-satellite');
            const coords = AscentMap.addRoute(map, route, { width: 5 });
            if (coords) {
                AscentMap.marker(map, coords[0], { color: AscentMap.GREEN, popup: 'Trailhead' });
                AscentMap.marker(map, coords[coords.length - 1], { color: AscentMap.TERRACOTTA, popup: name + ' — summit' });
                AscentMap.fit(map, coords, { padding: 70, pitch: 60, bearing: -18 });

                const playBtn = document.getElementById('simbtn');
                const followBtn = document.getElementById('followbtn');
                const sim = AscentMap.simulate(map, coords, { onEnd: () => reset() });
                let mode = null;
                let speed = 1;

                const playHtml = m => m
                    ? '<i class="ti ti-player-stop-filled"></i> Stop'
                    : '<i class="ti ti-player-play-filled"></i> Play';
                const followHtml = m => m
                    ? '<i class="ti ti-player-stop-filled"></i> Stop'
                    : '<i class="ti ti-drone"></i> Follow route';

                function paint() {
                    playBtn.classList.toggle('playing', mode === 'overview');
                    followBtn.classList.toggle('playing', mode === 'follow');
                    playBtn.innerHTML = playHtml(mode === 'overview');
                    followBtn.innerHTML = followHtml(mode === 'follow');
                }
                function reset() {
                    mode = null; paint();
                    AscentMap.fit(map, coords, { padding: 70, pitch: 60, bearing: -18 });
                }
                function play(next) {
                    if (mode) sim.stop();
                    if (mode === next) { reset(); return; }
                    mode = next;
                    AscentMap.setBasemap(map, 'bm-satellite');
                    if (next === 'overview') AscentMap.fit(map, coords, { padding: 60, pitch: 55, bearing: 0 });
                    paint();
                    sim.start({ follow: next === 'follow', speed: speed });
                }
                playBtn?.addEventListener('click', () => play('overview'));
                followBtn?.addEventListener('click', () => play('follow'));

                const speedGroup = document.getElementById('speedGroup');
                speedGroup?.querySelectorAll('.speed-opt').forEach(b => b.addEventListener('click', () => {
                    speed = parseFloat(b.dataset.speed);
                    speedGroup.querySelectorAll('.speed-opt').forEach(x => x.classList.remove('active'));
                    b.classList.add('active');
                    if (mode) { const cur = mode; sim.stop(); mode = cur; paint(); sim.start({ follow: cur === 'follow', speed: speed }); }
                }));
            } else {
                AscentMap.marker(map, [lng, lat], { popup: name });
            }
        });
    </script>
}
