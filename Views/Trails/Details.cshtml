@model ascent_app.Models.Trail
@using Microsoft.AspNetCore.Identity
@using ascent_app.Models
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Name;
    var diffClass = (Model.Difficulty?.Label ?? "").ToLowerInvariant();
    var canManage = User.IsInRole("Guide") || User.IsInRole("Admin");
    var isAdmin = User.IsInRole("Admin");

    var reviews = Model.Reviews.OrderByDescending(r => r.CreatedAt).ToList();
    var avg = Model.AverageRating;
    var myId = UserManager.GetUserId(User);
    var myReview = myId is null ? null : reviews.FirstOrDefault(r => r.UserId == myId);
}

<a class="asc-nav-link d-inline-flex align-items-center gap-1 mt-4" asp-action="Index">
    <i class="ti ti-arrow-left"></i> Back to trails
</a>

<div class="d-flex align-items-end justify-content-between mt-2 mb-3">
    <div>
        <div class="tc-region"><i class="ti ti-map-pin"></i> @Model.Region?.Name</div>
        <h1 class="mb-0 d-inline-flex align-items-center gap-2">
            @Model.Name
            @if (Model.Difficulty is not null)
            {
                <span class="diff-inline diff-@diffClass">@Model.Difficulty.Label</span>
            }
        </h1>
        <div class="rating-line mt-1">
            @for (var i = 1; i <= 5; i++)
            {
                <i class="ti ti-star @(i <= Math.Round(avg) ? "on" : "off")"></i>
            }
            @if (reviews.Count > 0)
            {
                <span class="rating-text">@avg.ToString("0.0") · @reviews.Count review@(reviews.Count == 1 ? "" : "s")</span>
            }
            else
            {
                <span class="rating-text">No reviews yet</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <partial name="_FavoriteButton" model="Model" />
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn-ascent" asp-controller="HikeLogs" asp-action="Create" asp-route-trailId="@Model.Id">
                <i class="ti ti-plus"></i> Log this hike
            </a>
        }
        @if (canManage)
        {
            <a class="btn-ascent-outline" asp-action="Edit" asp-route-id="@Model.Id"><i class="ti ti-edit"></i> Edit</a>
            <a class="btn-ascent-outline" asp-action="Delete" asp-route-id="@Model.Id"><i class="ti ti-trash"></i> Delete</a>
        }
    </div>
</div>

<div class="trail-detail-media mb-4">
    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
    {
        <img src="@Model.PhotoUrl" alt="@Model.Name">
    }
    else
    {
        <i class="ti ti-mountain placeholder"></i>
    }
</div>

<div class="stat-row mb-4">
    <div class="stat-card">
        <div class="label"><i class="ti ti-route"></i> Distance</div>
        <div class="value">@Model.DistanceKm km</div>
    </div>
    <div class="stat-card">
        <div class="label"><i class="ti ti-mountain"></i> Elevation gain</div>
        <div class="value">@Model.ElevationGainM m</div>
    </div>
    <div class="stat-card">
        <div class="label"><i class="ti ti-chart-line"></i> Difficulty</div>
        <div class="value">@(Model.Difficulty?.Label ?? "—")</div>
    </div>
    <div class="stat-card">
        <div class="label"><i class="ti ti-map-pin"></i> Region</div>
        <div class="value">@(Model.Region?.Name ?? "—")</div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <p class="eyebrow mb-2">ABOUT THIS TRAIL</p>
        <p class="lead" style="font-size:16px">@Model.ShortDescription</p>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-secondary">@Model.Description</p>
        }
        @if (Model.TrailTags.Any())
        {
            <div class="d-flex gap-2 flex-wrap mt-2">
                @foreach (var tt in Model.TrailTags.OrderBy(x => x.Tag.Name))
                {
                    <span class="asc-chip"><i class="ti ti-tag"></i> @tt.Tag.Name</span>
                }
            </div>
        }
    </div>
    <div class="col-md-4">
        <div class="asc-panel">
            <p class="eyebrow mb-2">TRAILHEAD</p>
            <p class="mb-2" style="font-size:14px">
                <i class="ti ti-current-location"></i>
                @Model.Latitude.ToString("0.0000"), @Model.Longitude.ToString("0.0000")
            </p>
            <div id="trailmap" class="map-box-sm"></div>
            <a class="asc-nav-link mt-2 d-inline-block" asp-action="Nearby">
                <i class="ti ti-navigation"></i> Find trails near you
            </a>
        </div>
    </div>
</div>

<div class="meta-row mt-4">
    <span><i class="ti ti-user"></i> Added by @(Model.Author?.DisplayName ?? "—")</span>
    <span><i class="ti ti-calendar"></i> @Model.CreatedAt.ToString("MMM d, yyyy")</span>
</div>

<hr class="my-4" />

<div class="row">
    <div class="col-md-7">
        <p class="eyebrow mb-3">REVIEWS</p>

        @if (reviews.Count == 0)
        {
            <p class="text-muted" style="font-size:14px">Be the first to review this trail.</p>
        }
        else
        {
            foreach (var review in reviews)
            {
                <div class="review-item mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="review-author">@(review.User?.DisplayName ?? "Hiker")</span>
                            <span class="review-stars">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="ti ti-star @(i <= review.Rating ? "on" : "off")"></i>
                                }
                            </span>
                        </div>
                        @if (review.UserId == myId || isAdmin)
                        {
                            <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@review.Id"
                                  method="post" onsubmit="return confirm('Delete this review?');">
                                <button type="submit" class="review-del" title="Delete review">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="mb-1 mt-1" style="font-size:14px">@review.Comment</p>
                    }
                    <div class="text-muted" style="font-size:12px">@review.CreatedAt.ToString("MMM d, yyyy")</div>
                </div>
            }
        }
    </div>

    <div class="col-md-5">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="asc-panel">
                <p class="eyebrow mb-2">@(myReview is null ? "WRITE A REVIEW" : "UPDATE YOUR REVIEW")</p>

                @if (TempData["ReviewError"] is string reviewError)
                {
                    <p class="text-danger" style="font-size:13px">@reviewError</p>
                }

                <form asp-controller="Reviews" asp-action="Create" method="post">
                    <input type="hidden" name="TrailId" value="@Model.Id" />

                    <div class="mb-2">
                        <label class="form-label">Rating</label>
                        <select name="Rating" class="form-select">
                            @for (var i = 5; i >= 1; i--)
                            {
                                var selected = (myReview?.Rating ?? 5) == i;
                                <option value="@i" selected="@selected">@i star@(i == 1 ? "" : "s")</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Comment <span class="text-muted">(optional)</span></label>
                        <textarea name="Comment" class="form-control" rows="3" maxlength="1000">@myReview?.Comment</textarea>
                    </div>
                    <button type="submit" class="btn-ascent">
                        @(myReview is null ? "Post review" : "Update review")
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="asc-panel text-center">
                <p class="mb-2" style="font-size:14px">Sign in to leave a review.</p>
                <a class="btn-ascent" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Trails", new { id = Model.Id })">
                    <i class="ti ti-user"></i> Sign in
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        const lat = @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const lng = @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const map = L.map('trailmap', { scrollWheelZoom: false }).setView([lat, lng], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);
        L.marker([lat, lng]).addTo(map).bindPopup(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Name)));
    </script>
}
