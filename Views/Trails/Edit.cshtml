@model ascent_app.ViewModels.TrailFormViewModel

@{
    ViewData["Title"] = "Edit trail";
}

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div class="tf-head">
        <div>
            <p class="eyebrow mb-1">EDIT TRAIL</p>
            <h1 class="mb-0">@Model.Name</h1>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a class="asc-nav-link me-2" asp-action="Details" asp-route-id="@Model.Id"><i class="ti ti-eye"></i> View trail</a>
            <a class="btn-ascent-outline" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            <button type="submit" class="btn-ascent">Save changes</button>
        </div>
    </div>

    <partial name="_TrailForm" model="Model" />

    <div class="d-flex gap-2 mt-3 justify-content-end">
        <a class="btn-ascent-outline" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        <button type="submit" class="btn-ascent">Save changes</button>
    </div>
</form>

@section Styles {
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
}

@section Scripts {
    <partial name="_TrailFormScripts" />
}
