@model ascent_app.ViewModels.NearbyViewModel
@{
    ViewData["Title"] = "Trails near you";

    var markers = Model.Trails.Select(x => new
    {
        name = x.Trail.Name,
        lat = x.Trail.Latitude,
        lng = x.Trail.Longitude,
        region = x.Trail.Region?.Name ?? "",
        route = x.Trail.RouteGeoJson,
        url = Url.Action("Details", "Trails", new { id = x.Trail.Id }),
    });
    var markersJson = System.Text.Json.JsonSerializer.Serialize(markers);
}

@section Styles {
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
}

<div class="d-flex align-items-end justify-content-between mt-4 mb-3">
    <div>
        <p class="eyebrow mb-1">EXPLORE</p>
        <h1 class="mb-0">Trails near you</h1>
    </div>
    <button id="locate" class="btn-ascent" type="button">
        <i class="ti ti-navigation"></i> Use my location
    </button>
</div>

@if (!Model.HasLocation)
{
    <p class="text-secondary mb-3" style="font-size:14px">
        Showing all trails. Tap <strong>Use my location</strong> to sort them by distance from where you are.
    </p>
}

<div id="map" class="map-box mb-4"></div>

<div class="row">
    @foreach (var item in Model.Trails)
    {
        var diffClass = (item.Trail.Difficulty?.Label ?? "").ToLowerInvariant();
        <div class="col-md-6 mb-2">
            <a class="asc-panel d-flex justify-content-between align-items-center text-decoration-none"
               style="padding:12px 14px" asp-action="Details" asp-route-id="@item.Trail.Id">
                <div>
                    <div class="tc-region"><i class="ti ti-map-pin"></i> @item.Trail.Region?.Name</div>
                    <span class="tc-title" style="font-size:15px">@item.Trail.Name</span>
                </div>
                <div class="text-end">
                    @if (item.DistanceKm.HasValue)
                    {
                        <div class="dist-badge"><i class="ti ti-route"></i> @item.DistanceKm km away</div>
                    }
                    @if (item.Trail.Difficulty is not null)
                    {
                        <span class="diff-inline diff-@diffClass">@item.Trail.Difficulty.Label</span>
                    }
                </div>
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script src="~/js/ascent-map.js" asp-append-version="true"></script>
    <script>
        const trails = @Html.Raw(markersJson);
        const user = @(Model.HasLocation ? Html.Raw($"[{Model.Lng}, {Model.Lat}]") : Html.Raw("null"));

        const map = AscentMap.display('map', { pitch: 45, cooperative: true });
        AscentMap.onReady(map, () => {
            const all = [];
            trails.forEach(t => {
                const coords = AscentMap.addRoute(map, t.route, { width: 3 });
                AscentMap.marker(map, [t.lng, t.lat], {
                    popup: '<a href="' + t.url + '"><strong>' + t.name + '</strong></a><br>' + t.region
                });
                (coords || [[t.lng, t.lat]]).forEach(c => all.push(c));
            });
            if (user) {
                AscentMap.marker(map, user, { color: AscentMap.TERRACOTTA, popup: 'You are here' });
                all.push(user);
            }
            AscentMap.fit(map, all, { padding: 50, pitch: 45 });
        });

        document.getElementById('locate').addEventListener('click', () => {
            if (!navigator.geolocation) { alert('Geolocation is not supported by your browser.'); return; }
            navigator.geolocation.getCurrentPosition(
                p => window.location = '@Url.Action("Nearby", "Trails")?lat=' + p.coords.latitude + '&lng=' + p.coords.longitude,
                () => alert('Could not get your location.'));
        });
    </script>
}
