@model ascent_app.ViewModels.TrailFormViewModel

@{
    ViewData["Title"] = "New trail";
}

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="tf-head">
        <div>
            <p class="eyebrow mb-1">NEW TRAIL</p>
            <h1 class="mb-0">Add a trail</h1>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a class="btn-ascent-outline" asp-action="Index">Cancel</a>
            <button type="submit" class="btn-ascent">Create trail</button>
        </div>
    </div>

    <partial name="_TrailForm" model="Model" />

    <div class="d-flex gap-2 mt-3 justify-content-end">
        <a class="btn-ascent-outline" asp-action="Index">Cancel</a>
        <button type="submit" class="btn-ascent">Create trail</button>
    </div>
</form>

@section Styles {
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
}

@section Scripts {
    <partial name="_TrailFormScripts" />
}
